@model IEnumerable<TvkLesson07Annotation.Models.TvkMember>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TvkUserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TvkPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TvkEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TvkPhone)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.TvkUserName)
            </td>
            <td>
                @Html.DisplayFor(model => item.TvkPassword)
            </td>
            <td>
                @Html.DisplayFor(model => item.TvkEmail)
            </td>
            <td>
                @Html.DisplayFor(model => item.TvkPhone)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
